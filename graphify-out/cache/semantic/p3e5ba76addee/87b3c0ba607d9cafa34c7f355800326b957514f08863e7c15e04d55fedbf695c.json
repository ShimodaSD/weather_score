: "https://x.com/richardrx/status/2033502548301091057"}, {"id": "_agents_skills_revenue_centric_design_references_pricing_and_monetization__richardrx___2026_03_05", "label": "@richardrx \u00b7 2026-03-05", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/pricing-and-monetization.md", "source_location": "link: @richardrx \u00b7 2026-03-05", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2029623167900061970"}, {"id": "_agents_skills_revenue_centric_design_references_pricing_and_monetization__richardrx___2026_02_03", "label": "@richardrx \u00b7 2026-02-03", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/pricing-and-monetization.md", "source_location": "link: @richardrx \u00b7 2026-02-03", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2018693884449009956"}, {"id": "_agents_skills_revenue_centric_design_references_pricing_and_monetization__richardrx___2026_02_02", "label": "@richardrx \u00b7 2026-02-02", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/pricing-and-monetization.md", "source_location": "link: @richardrx \u00b7 2026-02-02", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2018357024543715480"}], "edges": [{"source": "_agents_skills_revenue_centric_design_references_pricing_and_monetization_pricing___monetization_psychology", "target": "_agents_skills_revenue_centric_design_references_pricing_and_monetization_use_a_disfluent_font_for_genuine_deals___and_name_tiers_for_the_mix_you_want", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/revenue-centric-design/references/pricing-and-monetization.md", "source_location": "section: Use a disfluent fon