{"nodes": [{"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms_checkout___forms__conversion_completion_layer_", "label": "Checkout & Forms (Conversion-Completion Layer)", "file_type": "document", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "document", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms_friction_kills_conversion___field_count__input_type__and_perceived_risk_all_compound", "label": "Friction kills conversion \u2014 field count, input type, and perceived risk all compound", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "section: Friction kills conversion \u2014 field count, input type, and perceived risk all compound", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More fields = lower conversion, but the *type* of input matters too: text fields usually generate less impact, while dropdowns and textareas hurt more. Phone number drops conversion; any data that raises perceived risk or invasiveness does the same. And perceived effort \u2260 real effort \u2014 5 steps with 2 fields per screen can beat 2 screens with 7 fields each."}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms_microcopy_at_the_point_of_fraud_risk_beats_friction_everywhere_else", "label": "Microcopy at the point of fraud risk beats friction everywhere else", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "section: Microcopy at the point of fraud risk beats friction everywhere else", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design must protect the user from the real environment the product lives in \u2014 especially in low-trust economies. One line of microcopy in the right place prevents scams that cost more than the friction of adding it."}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms_you_lose_money_on_the_boring_screens", "label": "You lose money on the boring screens", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "section: You lose money on the boring screens", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registration forms are where you lose users one input at a time, creating holes in your bucket and wasting CAC \u2014 while founders polish the hero. The idea is to remove cognitive load until the flow is so smooth the user doesn't notice it."}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms_checkout_is_where__70__of_drops_happen___every_extra_input_is_less_conversion", "label": "Checkout is where ~70% of drops happen \u2014 every extra input is less conversion", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "section: Checkout is where ~70% of drops happen \u2014 every extra input is less conversion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At checkout, less is more. Each extra input is less conversion; ask for the minimum possible. Any new negative surprise is a reason to cancel \u2014 expensive shipping, paid shipping at all, service fee, packaging fee \u2014 embed every extra charge into the product price, never as a hidden extra."}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms_97__of_visitors_buy_nothing___the_leaks_are_known_and_fixable", "label": "97% of visitors buy nothing \u2014 the leaks are known and fixable", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "section: 97% of visitors buy nothing \u2014 the leaks are known and fixable", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cart abandonment reasons are mapped and mostly design-fixable: late extra costs (49%), forced account creation (24%), slow delivery (19%), complicated checkout (18%), distrust of the site (17%), unclear price (17%), site errors (12%), bad return policy (11%)."}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms__richardrx___2026_08_12", "label": "@richardrx \u00b7 2026-08-12", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "link: @richardrx \u00b7 2026-08-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2087502085151424711"}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms__richardrx___2026_06_29", "label": "@richardrx \u00b7 2026-06-29", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "link: @richardrx \u00b7 2026-06-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2071546806987538924"}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms__richardrx___2025_12_23", "label": "@richardrx \u00b7 2025-12-23", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/checkout-and-forms.md", "source_location": "link: @richardrx \u00b7 2025-12-23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2003495704849760387"}, {"id": "_agents_skills_revenue_centric_design_references_checkout_and_forms__richardrx___2025_12_12", "label": "@richardrx \u