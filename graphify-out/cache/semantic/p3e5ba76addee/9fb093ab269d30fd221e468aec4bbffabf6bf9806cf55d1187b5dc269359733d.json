{"nodes": [{"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_onboarding___activation", "label": "Onboarding & Activation", "file_type": "document", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "document", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_map_the_whole_journey_to_value___then_fix_the_biggest_drop__not_the_first_step", "label": "Map the whole journey to value \u2014 then fix the biggest drop, not the first step", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Map the whole journey to value \u2014 then fix the biggest drop, not the first step", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Founders rush to the top of the funnel when activation falls, but the leak is usually in the middle \u2014 the step where effort is already high and the user hasn't seen proof it's worth it. Method: (1) Define what \"value\" is (the first moment the user gets the promised result \u2014 measurable, visible in data). (2) List every step between signup and that value (every screen, click, wait, field \u2014 always more than you remember). (3) Measure drop per step; find the steepest fall. (4) Fix the biggest drop first \u2014 that's where the money is. (5) Diagnose why: friction (cut), confusion (direct attention), ordering (deliver value before asking effort)."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_an_onboarding_video_welcomes___it_doesn_t_teach", "label": "An onboarding video welcomes \u2014 it doesn't teach", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: An onboarding video welcomes \u2014 it doesn't teach", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A good onboarding video isn't a manual (nobody reads their car's or iPhone's). It welcomes, builds connection, shows the product at a glance, and points to where value comes fastest."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_rising_mrr_with_rising_churn_means_you_lost_them_on_day_one", "label": "Rising MRR with rising churn means you lost them on day one", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Rising MRR with rising churn means you lost them on day one", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When MRR and churn climb together, the user didn't leave in month 2 \u2014 they were lost the first day, dropped into a dead empty-state dashboard with nothing guiding them to value."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_measure_activation__not_signups", "label": "Measure activation, not signups", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Measure activation, not signups", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Technical founders track the wrong onboarding metrics; signups, session time, and tour completion all flatter you without proving the user reached value."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_put_friction_in_the_right_place__not_zero_friction_everywhere", "label": "Put friction in the right place, not zero friction everywhere", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Put friction in the right place, not zero friction everywhere", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Friction in the wrong place kills the product; friction in the right place qualifies and retains. \"Less friction\" is not a universal law."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_never_ship_a_blank_dashboard", "label": "Never ship a blank dashboard", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Never ship a blank dashboard", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The empty dashboard arrives at the user's peak of curiosity and answers it with a void \u2014 this is where most SaaS loses the trial. Every second spent deciding what to do is a second closer to quitting."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_design_onboarding_as_a_behavioral_trigger__not_a_feature_tour", "label": "Design onboarding as a behavioral trigger, not a feature tour", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Design onboarding as a behavioral trigger, not a feature tour", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Silent non-activation \u2014 users who sign up, vanish in five minutes, and never formally churn \u2014 is an activation problem, not a product one. Onboarding should fire a behavior, not narrate features."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_map_the_journey_from_session_replays__not_from_your_diagram", "label": "Map the journey from session replays, not from your diagram", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Map the journey from session replays, not from your diagram", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The founder's 12-step journey is built top-down (what the product wants); the user runs 4 steps bottom-up (the specific problem they opened the tab to solve). The gap between them is where avoidable early-stage churn lives \u2014 and it's invisible because the founder only ever lived the creator's journey."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_add_declarative_friction__cut_administrative_friction", "label": "Add declarative friction, cut administrative friction", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Add declarative friction, cut administrative friction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\"Good onboarding is short onboarding\" is incomplete. There are two frictions: administrative (collects data the system uses later, buys the user nothing) and declarative (forces the user to state what they came to do \u2014 costs a beat, buys commitment, customization, and journey direction)."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_trial_conversion_is_a_journey_problem__not_a_pricing_problem", "label": "Trial conversion is a journey problem, not a pricing problem", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Trial conversion is a journey problem, not a pricing problem", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A trial is a test of value; if the user never proves value to themselves, no price or trial length saves it. Conversion fails for three diagnosable reasons."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_make_onboarding_active__not_passive", "label": "Make onboarding active, not passive", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Make onboarding active, not passive", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passive onboarding (tooltips, guided tour, docs \u2014 learn if you want) assumes the user will explore. They won't: they have 47 tabs open, WhatsApp pinging, and will do the bare minimum before deciding whether to return. Active onboarding designs a sequence where each action delivers value and that value triggers the next."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_treat_sub_30_day_churn_as_an_onboarding_fix__not_a_feature_gap", "label": "Treat sub-30-day churn as an onboarding fix, not a feature gap", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Treat sub-30-day churn as an onboarding fix, not a feature gap", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most early-stage SaaS churn happens in the first 30 days \u2014 which means it's onboarding, not product. Adding features only makes it worse by adding complexity."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_deliver_the_promised_result_before_teaching_mechanics", "label": "Deliver the promised result before teaching mechanics", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Deliver the promised result before teaching mechanics", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nobody wants to learn to use your product; they want the result you promised in the landing-page hero. Teaching mechanics first (\"create a project \u2192 add a member \u2192 configure integrations\") is boring; delivering value first converts."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_qualify_by_behavior__not_by_a_long_signup_form", "label": "Qualify by behavior, not by a long signup form", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Qualify by behavior, not by a long signup form", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Friction at the wrong moment kills conversion, and qualification by behavior is more precise than qualification by form. The \"more qualified leads\" argument for long forms usually loses."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_celebrate_the_activation_moment__don_t_just_confirm_it", "label": "Celebrate the activation moment, don't just confirm it", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Celebrate the activation moment, don't just confirm it", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At the emotional peak of activation, a number is data but a rising graph is progress \u2014 and progress triggers dopamine and an emotional memory tied to the product. Most SaaS confirms where it should celebrate."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_cut_time_to_value_by_reorder_and_removal__not_feature_changes", "label": "Cut time-to-value by reorder and removal, not feature changes", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Cut time-to-value by reorder and removal, not feature changes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High TTV is almost never product complexity \u2014 it's the form and order in which things happen. Each day between signup and first result is another day of abandonment risk; abandonment = churn."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_give_the_trial_an_active_goal__not_passive_access", "label": "Give the trial an active goal, not passive access", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Give the trial an active goal, not passive access", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A passive trial (\"use it if you want, cancel guilt-free\") builds no commitment; a trial with an active goal builds commitment before billing. Each completed day raises the psychological cost of canceling \u2014 the user starts defending a decision they already made, before paying."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_calibrate_the_first_step_to_the_user_s_real_willingness", "label": "Calibrate the first step to the user's real willingness", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Calibrate the first step to the user's real willingness", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users don't rationally evaluate the first task \u2014 they evaluate perceived effort. Ask too much up front and the cognitive cost of even imagining the task is paralyzing, and they quit before starting. This is the activation-barrier effect."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_treat_onboarding_as_the_bridge_between_cac_and_ltv", "label": "Treat onboarding as the bridge between CAC and LTV", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Treat onboarding as the bridge between CAC and LTV", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Founders obsess over CAC and landing-page conversion but are blind to activation cost. Onboarding isn't an interface tutorial \u2014 it's the bridge from CAC to LTV and the point of maximum leverage to expand revenue. Cancellation happens on day one; it's merely formalized when Stripe's billing reminder lands."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation_pick_onboarding_patterns_by_awareness___flow_complexity", "label": "Pick onboarding patterns by awareness \u00d7 flow complexity", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "section: Pick onboarding patterns by awareness \u00d7 flow complexity", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There's no best onboarding in the abstract \u2014 only the one that removes friction and delivers value early for your users. Treat the nine patterns as behavior-shaping mechanisms, not UI components, and select by two axes."}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_07_08", "label": "@richardrx \u00b7 2026-07-08", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-07-08", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2074814716824731651"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_06_19", "label": "@richardrx \u00b7 2026-06-19", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-06-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2067987722954735812"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_06_18", "label": "@richardrx \u00b7 2026-06-18", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-06-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2067591574138052804"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_05_27", "label": "@richardrx \u00b7 2026-05-27", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-05-27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2059616501544468624"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_05_21", "label": "@richardrx \u00b7 2026-05-21", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-05-21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2057436163841941980"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_05_12", "label": "@richardrx \u00b7 2026-05-12", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-05-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2054283657934758021"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_05_11", "label": "@richardrx \u00b7 2026-05-11", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-05-11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2053878928494690414"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_05_08", "label": "@richardrx \u00b7 2026-05-08", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-05-08", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2052711138572263474"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_05_07", "label": "@richardrx \u00b7 2026-05-07", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-05-07", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2052350703541039324"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_05_06", "label": "@richardrx \u00b7 2026-05-06", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-05-06", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2052096365128273956"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_04_22", "label": "@richardrx \u00b7 2026-04-22", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-04-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2046959126245249288"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_04_20", "label": "@richardrx \u00b7 2026-04-20", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-04-20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2046212675017887881"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_04_16", "label": "@richardrx \u00b7 2026-04-16", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-04-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2044785090832543998"}, {"id": "_agents_skills_revenue_centric_design_references_onboarding_and_activation__richardrx___2026_04_10", "label": "@richardrx \u00b7 2026-04-10", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/onboarding-and-activation.md", "source_location": "link: @richardrx \u00b7 2026-04-10", "source_url": null, "cap