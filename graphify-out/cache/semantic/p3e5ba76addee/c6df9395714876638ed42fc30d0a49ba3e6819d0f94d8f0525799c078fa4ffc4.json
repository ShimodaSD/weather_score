{"nodes": [{"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_behavioral_science___persuasion", "label": "Behavioral Science & Persuasion", "file_type": "document", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "document", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_you_can_t_un_hear_your_own_product", "label": "You can't un-hear your own product", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "section: You can't un-hear your own product", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once you know how your product works, that knowledge permanently rewrites your perception \u2014 what feels obvious to you is just \"tap-tap-tap\" to a first-time user. You'll mistake confused users for dumb users."}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_set_the_default___it_s_the_most_underrated_lever_in_conversion", "label": "Set the default \u2014 it's the most underrated lever in conversion", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "section: Set the default \u2014 it's the most underrated lever in conversion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pre-selected option captures the overwhelming majority of choices, because deciding is expensive and the lazy brain takes the easiest path. Smart defaults beat copy persuasion."}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_reinforce_the_decision_the_user_just_made", "label": "Reinforce the decision the user just made", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "section: Reinforce the decision the user just made", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After committing to a choice, people actively seek information that supports it \u2014 choice-supportive bias. You can feed that need to make the decision feel right."}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_architect_for_what_users_fear_losing__not_just_what_they_gain", "label": "Architect for what users fear losing, not just what they gain", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "section: Architect for what users fear losing, not just what they gain", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builders obsess over features (gains), but conversion and retention are cemented by what the user fears losing \u2014 the pain of abandoning a built-up ecosystem outweighs the pain of paying a subscription."}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_use_precise_numbers__not_round_ones__to_signal_truth", "label": "Use precise numbers, not round ones, to signal truth", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "section: Use precise numbers, not round ones, to signal truth", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact figures read as more credible than rounded ones; round numbers signal marketing while specific numbers signal reality."}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_guide_the_eye___don_t_give_every_option_equal_weight", "label": "Guide the eye \u2014 don't give every option equal weight", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "section: Guide the eye \u2014 don't give every option equal weight", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The brain uses contrast to make fast decisions (Von Restorff effect). When competing options carry identical visual weight, you create mental friction, decision time rises, and conversion falls. Guiding the user isn't manipulation \u2014 it's respect for their time."}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit_cut_cognitive_load___every_choice_you_remove_can_lift_conversion", "label": "Cut cognitive load \u2014 every choice you remove can lift conversion", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "section: Cut cognitive load \u2014 every choice you remove can lift conversion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each extra field, choice, or block of complex text spends the user's mental energy and triggers analysis paralysis. Your product can be complex; your interface doesn't have to be."}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit__richardrx___2026_06_04", "label": "@richardrx \u00b7 2026-06-04", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "link: @richardrx \u00b7 2026-06-04", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2062509937037590997"}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit__richardrx___2026_05_22", "label": "@richardrx \u00b7 2026-05-22", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "link: @richardrx \u00b7 2026-05-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2057872036718899256"}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit__richardrx___2026_04_29", "label": "@richardrx \u00b7 2026-04-29", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "link: @richardrx \u00b7 2026-04-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2049392897598849333"}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit__richardrx___2026_03_02", "label": "@richardrx \u00b7 2026-03-02", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "link: @richardrx \u00b7 2026-03-02", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2028471666297217460"}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit__richardrx___2026_02_18", "label": "@richardrx \u00b7 2026-02-18", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_location": "link: @richardrx \u00b7 2026-02-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2024141244717281514"}, {"id": "_agents_skills_revenue_centric_design_references_behavioral_science_toolkit__richardrx___2026_01_22", "label": "@richardrx \u00b7 2026-01-22", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/behavioral-science-toolkit.md", "source_