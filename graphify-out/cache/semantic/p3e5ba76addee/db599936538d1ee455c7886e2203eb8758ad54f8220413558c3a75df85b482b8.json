{"nodes": [{"id": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_dashboards___data_visualization__retention_surface_", "label": "Dashboards & Data Visualization (Retention Surface)", "file_type": "document", "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "document", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_removing_information_creates_room_for_direction___the_dashboard_should_say_what_to_do_with_the_data", "label": "Removing information creates room for direction \u2014 the dashboard should say what to do with the data", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "section: Removing information creates room for direction \u2014 the dashboard should say what to do with the data", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Good product design work is mostly *removing*: showing less and giving clarity to what remains, based on what the user needs on that screen. Removing information opens space for direction \u2014 the app stops just showing data and starts saying what to do with it. That's the actionable layer."}, {"id": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_a_good_dashboard_informs_at_a_glance___like_a_car_dashboard__the_user_must_focus_on_where_they_re_going", "label": "A good dashboard informs at a glance \u2014 like a car dashboard, the user must focus on where they're going", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "section: A good dashboard informs at a glance \u2014 like a car dashboard, the user must focus on where they're going", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A good dashboard is informative and effortless to read \u2014 the main KPI sits top-left (F-pattern), every element either earns its place or is noise. The goal isn't informing: it's eliminating churn and maximizing LTV through value so large the user feels the need to return."}, {"id": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_dashboards__not_a_pile_of_gauges___every_extra_indicator_slows_the_scan_for_what_s_actionable", "label": "Dashboards: not a pile of gauges \u2014 every extra indicator slows the scan for what's actionable", "file_type": "rationale", "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "section: Dashboards: not a pile of gauges \u2014 every extra indicator slows the scan for what's actionable", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original \"dashboard\" was a board on carriages that kept horse mud off the passengers; the first Ford T kept the design with just an ignition key and an ammeter, and gauges accumulated from there. That industrial-era aesthetic survives in luxury cars and watches \u2014 the \"complications\" on a Patek Philippe or a Pagani \u2014 where it's interesting; in a software dashboard it isn't. The more information on screen, the higher the cognitive load and the longer it takes to scan for what is important and actionable. A good dashboard is built around the business's main indicators."}, {"id": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz__richardrx___2026_07_10", "label": "@richardrx \u00b7 2026-07-10", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "link: @richardrx \u00b7 2026-07-10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2075623473565647202"}, {"id": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz__richardrx___2025_12_16", "label": "@richardrx \u00b7 2025-12-16", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "link: @richardrx \u00b7 2025-12-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/2000930776636940333"}, {"id": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz__richardrx___2025_11_04", "label": "@richardrx \u00b7 2025-11-04", "file_type": "concept", "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "link: @richardrx \u00b7 2025-11-04", "source_url": null, "captured_at": null, "author": null, "contributor": null, "reference_url": "https://x.com/richardrx/status/1985828780838097317"}], "edges": [{"source": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_dashboards___data_visualization__retention_surface_", "target": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_removing_information_creates_room_for_direction___the_dashboard_should_say_what_to_do_with_the_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/revenue-centric-design/references/dashboards-and-data-viz.md", "source_location": "section: Removing information creates room for direction \u2014 the dashboard should say what to do with the data", "weight": 1.0}, {"source": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_dashboards___data_visualization__retention_surface_", "target": "_agents_skills_revenue_centric_design_references_dashboards_and_data_viz_a_good_dashboard_informs_at_a_glance___like_a_car_dashboard__the_user_must_focus_on_where_they_re_going", "relation": "references", "confidence": "EX